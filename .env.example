# Copy this file to ".env" and fill in your key.
#
# ANTHROPIC_API_KEY turns on automatic invoice reading for PDFs and photos.
# Without it the app still runs — CSV import and manual entry work fine.
ANTHROPIC_API_KEY=

# Port for the local web server.
PORT=4000

# Shared password for signing in to the app.
APP_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Only needed when running on a server, not on a Mac.
# ---------------------------------------------------------------------------

# Where the database and uploaded invoice files live. Leave this unset locally
# and they sit next to the app. On a host, point it at a disk that survives
# deploys — otherwise deploying replaces the app folder and takes every invoice
# with it. On Render this is the mount path of the attached disk.
# DATA_DIR=/var/data

# Force the session cookie to be marked Secure. Normally unnecessary: the app
# detects HTTPS from the host's proxy on its own. Set this to 1 only if your
# host terminates HTTPS without forwarding the usual headers.
# FORCE_SECURE_COOKIES=1
